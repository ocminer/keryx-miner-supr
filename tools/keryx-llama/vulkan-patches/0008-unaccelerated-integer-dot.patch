         }
 
-        device->integer_dot_product = device->integer_dot_product && shader_integer_dot_product_props.integerDotProduct4x8BitPackedSignedAccelerated;
+        // Keryx canonical trace: every product takes the q8_1 integer path, so the int8 pipelines are
+        // required, not an optimisation. Keep them wherever the extension exists (its feature is
+        // mandatory then) even if the driver reports the packed dot as not accelerated - e.g. RADV on
+        // RX 5700/5600 (Navi10) and GFX1013, which emulate it with plain integer ALU ops. Integer dot
+        // products are exact either way, so the committed trace is identical.
+        // KERYX_VK_ASSUME_UNACCELERATED_DOT=1 (test only) treats the card like RX 5700 for qualification.
+        device->integer_dot_accelerated = device->integer_dot_product && shader_integer_dot_product_props.integerDotProduct4x8BitPackedSignedAccelerated &&
+                                          !getenv("KERYX_VK_ASSUME_UNACCELERATED_DOT");
 
         device->min_imported_host_pointer_alignment = external_memory_host_props.minImportedHostPointerAlignment;
 
