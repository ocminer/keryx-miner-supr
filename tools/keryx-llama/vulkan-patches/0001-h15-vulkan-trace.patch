+// ── Keryx canonical trace: hooks ────────────────────────────────────────────
+
+static constexpr uint32_t VK_KERYX_NO_LEAF = 0xFFFFFFFFu;
+static constexpr uint32_t VK_KERYX_KIND_ROWS = 0;
+static constexpr uint32_t VK_KERYX_KIND_Q8 = 1;
+static constexpr uint32_t VK_KERYX_KIND_Q8_D4 = 2;
+static constexpr uint32_t VK_KERYX_KIND_Q8_DS4 = 3;
+static constexpr uint32_t VK_KERYX_COPY = 0x100;
+// keryx_trace.comp folds at most 1024 chunks of 1 KiB per row.
+static constexpr uint64_t VK_KERYX_MAX_ROW_BYTES = 1024 * 1024;
+
+static bool ggml_vk_keryx_armed(const vk_device & device) {
+    return device && device->idx < GGML_VK_MAX_DEVICES && vk_keryx_traces[device->idx].armed;
+}
+
+static void ggml_vk_keryx_fail(vk_keryx_trace & t, const std::string & why) {
+    if (t.error.empty()) {
+        t.error = why;
+    }
+}
+
+// Records the BLAKE3 of `nrows` canonical rows of `src` as leaves `leaf_a`/`leaf_b` (-1 = none) of
+// positions `first_pos`.., and copies the rows an armed capture names. KIND_ROWS rows start at word
+// `src_off + row * row_stride`; KIND_Q8 rows are `k_blocks` q8_1 blocks each, packed from word
+// `src_off` as block_q8_1_x4 groups. Synchronized on both sides: the rows were written by the
+// previous dispatch, and later nodes may reuse their memory.
+static void ggml_vk_keryx_rows(ggml_backend_vk_context * ctx, vk_context & subctx, vk_keryx_trace & t, const vk_subbuffer & src,
+                               uint32_t src_off, uint32_t row_stride, uint64_t row_bytes, uint32_t kind, uint32_t k_blocks,
+                               uint64_t nrows, uint64_t first_pos, int leaf_a, int leaf_b, const char * what) {
+    if (nrows == 0) {
+        return;
+    }
+    if (row_bytes == 0 || row_bytes % 4 != 0 || row_bytes > VK_KERYX_MAX_ROW_BYTES) {
+        ggml_vk_keryx_fail(t, std::string("unsupported row of ") + std::to_string(row_bytes) + " bytes in " + what);
+        return;
+    }
+    if (first_pos + nrows > t.max_pos) {
+        ggml_vk_keryx_fail(t, "the evaluation passes the " + std::to_string(t.max_pos) + " traced positions");
+        return;
+    }
+    std::vector<std::pair<uint32_t, uint32_t>> copies;  // (row, capture slot)
+    for (size_t k = 0; k < t.cap_list.size(); k++) {
+        const uint64_t pos = t.cap_list[k].first;
+        const int leaf = (int) t.cap_list[k].second;
+        if (pos >= first_pos && pos < first_pos + nrows && (leaf == leaf_a || leaf == leaf_b)) {
+            if (row_bytes > t.cap_slot) {
+                ggml_vk_keryx_fail(t, std::string("capture of ") + what + " exceeds its slot");
+                continue;
+            }
+            copies.push_back({ (uint32_t) (pos - first_pos), (uint32_t) k });
+        }
+    }
+    vk_pipeline & pipe = ctx->device->pipeline_keryx_trace;
+    const vk_subbuffer leaves = { t.leaves, 0, t.leaves->size };
+    // Binding 2 must hold a buffer even when nothing is captured.
+    const vk_subbuffer caps = t.caps ? vk_subbuffer{ t.caps, 0, t.caps->size } : leaves;
+    ggml_pipeline_request_descriptor_sets(ctx, pipe, 1 + (uint32_t) copies.size());
+    ggml_vk_sync_buffers(ctx, subctx);
+    vk_keryx_trace_push_constants pc = {
+        src_off, row_stride, (uint32_t) row_bytes, kind, k_blocks, (uint32_t) first_pos, t.nl,
+        leaf_a < 0 ? VK_KERYX_NO_LEAF : (uint32_t) leaf_a, leaf_b < 0 ? VK_KERYX_NO_LEAF : (uint32_t) leaf_b, 0, 0,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipe, { src, leaves, caps }, pc, { (uint32_t) nrows, 1, 1 });
+    for (const auto & c : copies) {
+        vk_keryx_trace_push_constants cp = pc;
+        cp.kind = kind | VK_KERYX_COPY;
+        cp.cap_row = c.first;
+        cp.cap_off = c.second * (t.cap_slot / 4);
+        ggml_vk_dispatch_pipeline(ctx, subctx, pipe, { src, leaves, caps }, cp, { 1, 1, 1 });
+        t.cap_len[c.second] = (uint32_t) row_bytes;
+    }
+    ggml_vk_sync_buffers(ctx, subctx);
+}
+
+// The f32 rows of `x` as leaf `leaf` of positions `first_pos`...
+static void ggml_vk_keryx_tensor_rows(ggml_backend_vk_context * ctx, vk_context & subctx, vk_keryx_trace & t, const ggml_tensor * x,
+                                      int leaf, uint64_t first_pos) {
+    if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x)) {
+        ggml_vk_keryx_fail(t, std::string("traced tensor ") + x->name + " is not contiguous f32");
+        return;
+    }
+    const vk_subbuffer sb = ggml_vk_tensor_subbuffer(ctx, x, true);
+    const uint64_t misalign = ggml_vk_tensor_buffer_offset(ctx, x) - sb.offset;
+    ggml_vk_keryx_rows(ctx, subctx, t, sb, (uint32_t) (misalign / 4), (uint32_t) x->ne[0], (uint64_t) x->ne[0] * 4, VK_KERYX_KIND_ROWS, 0,
+                       (uint64_t) ggml_nrows(x), first_pos, leaf, -1, x->name);
+}
+
+// Rows of a traced tensor sit at the last positions of the batch when it holds fewer rows (the
+// output rows of the head, a trimmed last layer).
+static uint64_t ggml_vk_keryx_first_pos(const vk_keryx_trace & t, uint64_t nrows) {
+    return t.pos_base + (t.n_tokens > nrows ? t.n_tokens - nrows : 0);
+}
+
+// Manifest rank of the product `w` is a weight of, or -1.
+static int ggml_vk_keryx_rank(const vk_keryx_trace & t, const ggml_tensor * w) {
+    if (!w) {
+        return -1;
+    }
+    const auto it = t.rank.find(w->name);
+    return it == t.rank.end() ? -1 : it->second;
+}
+
+// Whether the product of weight `w` takes CUDA's MMQ tile arithmetic (MAT_VEC_FUSION_FLAGS_KERYX_DS4):
+// the batch is committed past 8 tokens, the weight is Q4_K/Q5_K, and the product is not the head,
+// whose input the verifier always reads in the MMVQ layout.
+static bool ggml_vk_keryx_mmq_tiles(const vk_device & device, const ggml_tensor * w) {
+    if (!ggml_vk_keryx_armed(device) || !w || (w->type != GGML_TYPE_Q4_K && w->type != GGML_TYPE_Q5_K)) {
+        return false;
+    }
+    const vk_keryx_trace & t = vk_keryx_traces[device->idx];
+    const int r = ggml_vk_keryx_rank(t, w);
+    return t.declared > 8 && r >= 0 && !t.prod[r].head;
+}
+
+// Residual leaf of a layer-stream node named `<kind>-<layer>`, or -1.
+static int ggml_vk_keryx_resid_leaf(const vk_keryx_trace & t, const char * name) {
+    const char * dash = strrchr(name, '-');
+    if (t.n_layers == 0 || !dash || dash[1] < '0' || dash[1] > '9') {
+        return -1;
+    }
+    char * end = nullptr;
+    const unsigned long il = strtoul(dash + 1, &end, 10);
+    if (*end != '\0' || il >= t.n_layers) {
+        return -1;
+    }
+    const size_t n = (size_t) (dash - name);
+    auto is = [&](const char * k) { return strlen(k) == n && strncmp(name, k, n) == 0; };
+    const int base = (int) (2 * t.n_products + 2 * il);
+    if (is("l_out")) {
+        return base + 1;
+    }
+    if (is("attn_residual") || is("ffn_inp") || is("attn_out")) {
+        return base;
+    }
+    if (t.n_router > 0 && is("ffn_moe_logits")) {
+        return (int) (2 * t.n_products + 2 * t.n_layers + il);
+    }
+    return -1;
+}
+
+// Layer index of a node named `<kind>-<layer>` whose kind is `kind`, or -1.
+static int ggml_vk_keryx_layer_of(const char * name, const char * kind) {
+    const char * dash = strrchr(name, '-');
+    const size_t n = strlen(kind);
+    if (!dash || (size_t) (dash - name) != n || strncmp(name, kind, n) != 0 || dash[1] < '0' || dash[1] > '9') {
+        return -1;
+    }
+    char * end = nullptr;
+    const unsigned long il = strtoul(dash + 1, &end, 10);
+    return *end == '\0' && il < 0x10000 ? (int) il : -1;
+}
+
+// The log softmax mass of every query row and head of the flash-attention node `node` of layer
+// `il`, into the mass buffer at the batch's positions.
+static void ggml_vk_keryx_lse(ggml_backend_vk_context * ctx, vk_context & subctx, vk_keryx_trace & t, const ggml_tensor * node, uint32_t il) {
+    const ggml_tensor * q = node->src[0];
+    const ggml_tensor * k = node->src[1];
+    const ggml_tensor * mask = node->src[3];
+    float scale, max_bias, softcap;
+    memcpy(&scale, (const float *) node->op_params + 0, sizeof(float));
+    memcpy(&max_bias, (const float *) node->op_params + 1, sizeof(float));
+    memcpy(&softcap, (const float *) node->op_params + 2, sizeof(float));
+    if (il >= t.lse_layers) {
+        ggml_vk_keryx_fail(t, "attention layer " + std::to_string(il) + " past the mass capture");
+        return;
+    }
+    if (q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_Q8_0 || (mask && mask->type != GGML_TYPE_F16) || max_bias != 0.0f || softcap != 0.0f ||
+        q->ne[3] != 1 || k->ne[3] != 1 || q->ne[0] != k->ne[0] || q->ne[0] % 32 != 0 || q->nb[0] != 4 || k->ne[2] == 0 || q->ne[2] % k->ne[2] != 0 ||
+        (uint64_t) q->ne[2] > t.lse_heads || node->src[4] != nullptr) {
+        ggml_vk_keryx_fail(t, std::string("unsupported attention node ") + node->name + " for the mass capture");
+        return;
+    }
+    const uint64_t n_q = (uint64_t) q->ne[1];
+    if (n_q != t.n_tokens || t.pos_base + n_q > t.max_pos) {
+        ggml_vk_keryx_fail(t, std::string("attention node ") + node->name + " does not cover the batch");
+        return;
+    }
+    const vk_subbuffer qb = ggml_vk_tensor_subbuffer(ctx, q, true);
+    const vk_subbuffer kb = ggml_vk_tensor_subbuffer(ctx, k, true);
+    const vk_subbuffer mb = mask ? ggml_vk_tensor_subbuffer(ctx, mask, true) : qb;
+    const uint64_t q_mis = ggml_vk_tensor_buffer_offset(ctx, q) - qb.offset;
+    const uint64_t k_mis = ggml_vk_tensor_buffer_offset(ctx, k) - kb.offset;
+    const uint64_t m_mis = mask ? ggml_vk_tensor_buffer_offset(ctx, mask) - mb.offset : 0;
+    if (q_mis % 4 != 0 || q->nb[1] % 4 != 0 || q->nb[2] % 4 != 0 || m_mis % 2 != 0 || (mask && mask->nb[1] % 2 != 0)) {
+        ggml_vk_keryx_fail(t, std::string("misaligned attention node ") + node->name + " for the mass capture");
+        return;
+    }
+    vk_pipeline & pipe = ctx->device->pipeline_keryx_lse;
+    const vk_subbuffer out = { t.lse, 0, t.lse->size };
+    ggml_pipeline_request_descriptor_sets(ctx, pipe, 1);
+    ggml_vk_sync_buffers(ctx, subctx);
+    vk_keryx_lse_push_constants pc = {
+        (uint32_t) (q_mis / 4), (uint32_t) (q->nb[1] / 4), (uint32_t) (q->nb[2] / 4),
+        (uint32_t) k_mis, (uint32_t) k->nb[1], (uint32_t) k->nb[2],
+        (uint32_t) (m_mis / 2), mask ? (uint32_t) (mask->nb[1] / 2) : 0u, mask ? 1u : 0u,
+        (uint32_t) k->ne[1], (uint32_t) q->ne[0], (uint32_t) (q->ne[2] / k->ne[2]), scale,
+        (uint32_t) (((uint64_t) il * t.max_pos + t.pos_base) * t.lse_heads), t.lse_heads,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipe, { qb, kb, mb, out }, pc, { (uint32_t) n_q, (uint32_t) q->ne[2], 1 });
+    ggml_vk_sync_buffers(ctx, subctx);
+}
+
+// Tokens a recorded batch holds at most (the miner's traced batch).
+static constexpr uint32_t VK_KERYX_REC_TOKENS = 8;
+
+// The record of every head of the fused gated-delta-net node `node` of layer `il` at every token of
+// the batch, and, when the batch ends a checkpoint interval, the state the node leaves behind.
+static void ggml_vk_keryx_recur(ggml_backend_vk_context * ctx, vk_context & subctx, vk_keryx_trace & t, const ggml_tensor * node, uint32_t il) {
+    const int slot = il < t.rec_slot.size() ? t.rec_slot[il] : -1;
+    if (slot < 0) {
+        ggml_vk_keryx_fail(t, std::string("recurrent node ") + node->name + " of no recurrent layer");
+        return;
+    }
+    const ggml_tensor * q = node->src[0];
+    const ggml_tensor * k = node->src[1];
+    const ggml_tensor * v = node->src[2];
+    const ggml_tensor * g = node->src[3];
+    const ggml_tensor * b = node->src[4];
+    const uint32_t S = (uint32_t) v->ne[0], H = (uint32_t) v->ne[1], n_tokens = (uint32_t) v->ne[2], H_k = (uint32_t) q->ne[1];
+    const bool kda = g->ne[0] == (int64_t) S && S > 1;
+    bool ok = node->type == GGML_TYPE_F32 && ggml_get_op_params_i32(node, 0) == 1 && v->ne[3] == 1 && q->ne[3] == 1 &&
+              S == t.rec_dim && H == t.rec_heads && kda == (t.rec_kda != 0) && H_k > 0 && H % H_k == 0 && q->ne[0] == (int64_t) S &&
+              n_tokens == t.n_tokens && n_tokens <= VK_KERYX_REC_TOKENS && k->nb[1] == q->nb[1] && k->nb[2] == q->nb[2];
+    for (int i = 0; i < 5; i++) {
+        ok = ok && node->src[i]->type == GGML_TYPE_F32 && node->src[i]->nb[0] == 4;
+    }
+    if (!ok) {
+        ggml_vk_keryx_fail(t, std::string("unsupported recurrent node ") + node->name + " for the record capture");
+        return;
+    }
+    vk_subbuffer sb[6];
+    uint32_t off[6];
+    const ggml_tensor * ts[6] = { q, k, v, g, b, node };
+    for (int i = 0; i < 6; i++) {
+        sb[i] = ggml_vk_tensor_subbuffer(ctx, ts[i], true);
+        const uint64_t mis = ggml_vk_tensor_buffer_offset(ctx, ts[i]) - sb[i].offset;
+        if (mis % 4 != 0) {
+            ggml_vk_keryx_fail(t, std::string("misaligned recurrent node ") + node->name + " for the record capture");
+            return;
+        }
+        off[i] = (uint32_t) (mis / 4);
+    }
+    vk_pipeline & pipe = ctx->device->pipeline_keryx_rec;
+    const vk_subbuffer out = { t.rec, 0, t.rec->size };
+    ggml_pipeline_request_descriptor_sets(ctx, pipe, 1);
+    ggml_vk_sync_buffers(ctx, subctx);
+    const vk_keryx_rec_push_constants pc = {
+        off[0], off[1], off[2], off[3], off[4], off[5],
+        (uint32_t) (q->nb[1] / 4), (uint32_t) (q->nb[2] / 4), (uint32_t) (v->nb[1] / 4), (uint32_t) (v->nb[2] / 4),
+        (uint32_t) (b->nb[1] / 4), (uint32_t) (b->nb[2] / 4),
+        H, H_k, S, kda ? 1u : 0u, t.rec_bytes / 4, (uint32_t) slot * H * VK_KERYX_REC_TOKENS * (t.rec_bytes / 4), VK_KERYX_REC_TOKENS,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipe, { sb[0], sb[1], sb[2], sb[3], sb[4], sb[5], out }, pc, { H, n_tokens, 1 });
+    if (t.rec_ckpt_due) {
+        // The node's output: the S * H outputs of each token, then the state of every head.
+        const size_t state_bytes = (size_t) S * S * H * 4;
+        const size_t src_off = ggml_vk_tensor_buffer_offset(ctx, node) + (size_t) S * H * n_tokens * 4;
+        ggml_vk_buffer_copy_async(subctx, t.rec_ckpt, (size_t) slot * state_bytes, sb[5].buffer, src_off, state_bytes);
+    }
+    ggml_vk_sync_buffers(ctx, subctx);
+    t.rec_seen[slot] = 1;
+}
+
+// After `node`'s own dispatch: the leaves it carries. A product matmul carries its q8_1 input rows
+// (and its output rows when the product is plain); the GLU of a gated pair or split product, or
+// the bias add of a biased one, carries that product's output; a residual node carries its rows.
+static void ggml_vk_keryx_on_node(ggml_backend_vk_context * ctx, vk_context & subctx, const ggml_tensor * node) {
+    vk_keryx_trace & t = vk_keryx_traces[ctx->device->idx];
+    if (node->op == GGML_OP_MUL_MAT) {
+        // Consumed here, so a later evaluation of the same graph cannot mistake it for its own.
+        const bool q8 = ctx->keryx_q8_node == node;
+        ctx->keryx_q8_node = nullptr;
+        const int r = ggml_vk_keryx_rank(t, node->src[0]);
+        if (r >= 0) {
+            const vk_keryx_product & p = t.prod[r];
+            if (!q8) {
+                ggml_vk_keryx_fail(t, std::string("product ") + node->src[0]->name + " did not take the q8_1 mat-vec path");
+                return;
+            }
+            const uint64_t k = ctx->keryx_q8_k, rows = ctx->keryx_q8_rows;
+            const uint64_t kp = (k + 511) / 512 * 512;
+            const uint64_t first = p.head ? ggml_vk_keryx_first_pos(t, rows) : t.pos_base;
+            const vk_subbuffer y = { ctx->prealloc_y, 0, ctx->prealloc_y->size };
+            // The layout the committed batch size gives the input (the verifier's `input_layout`):
+            // MMVQ up to 8 tokens and for the head, else CUDA's MMQ layout of the weight type. The
+            // values are the same q8_1 blocks; the row is as long in every layout.
+            uint32_t kind = VK_KERYX_KIND_Q8;
+            if (!p.head && t.declared > 8) {
+                const bool ds4 = p.wtype == GGML_TYPE_Q4_0 || p.wtype == GGML_TYPE_Q4_1 || p.wtype == GGML_TYPE_Q5_1 ||
+                                 p.wtype == GGML_TYPE_Q4_K || p.wtype == GGML_TYPE_Q5_K;
+                kind = ds4 ? VK_KERYX_KIND_Q8_DS4 : VK_KERYX_KIND_Q8_D4;
+            }
+            ggml_vk_keryx_rows(ctx, subctx, t, y, 0, 0, kp / 32 * 36, kind, (uint32_t) (k / 32), rows, first, 2 * r, -1,
+                               node->src[0]->name);
+            if (p.form == 0 && p.bias < 0) {
+                ggml_vk_keryx_tensor_rows(ctx, subctx, t, node, 2 * r + 1, p.head ? ggml_vk_keryx_first_pos(t, ggml_nrows(node)) : t.pos_base);
+            }
+        }
+    } else if (node->op == GGML_OP_GLU) {
+        for (int s = 0; s < 2; s++) {
+            const ggml_tensor * mm = node->src[s];
+            if (!mm || mm->op != GGML_OP_MUL_MAT) {
+                continue;
+            }
+            const int r = ggml_vk_keryx_rank(t, mm->src[0]);
+            if (r >= 0 && (t.prod[r].form == 1 || t.prod[r].form == 2)) {
+                ggml_vk_keryx_tensor_rows(ctx, subctx, t, node, 2 * r + 1,
+                                          t.prod[r].head ? ggml_vk_keryx_first_pos(t, ggml_nrows(node)) : t.pos_base);
+                break;
+            }
+        }
+    } else if (node->op == GGML_OP_ADD && node->src[0] && node->src[0]->op == GGML_OP_MUL_MAT && node->src[1]) {
+        const int r = ggml_vk_keryx_rank(t, node->src[0]->src[0]);
+        const char * bn = node->src[1]->name;
+        const size_t l = strlen(bn);
+        if (r >= 0 && t.prod[r].form == 0 && t.prod[r].bias >= 0 && l > 5 && strcmp(bn + l - 5, ".bias") == 0) {
+            ggml_vk_keryx_tensor_rows(ctx, subctx, t, node, 2 * r + 1, t.prod[r].head ? ggml_vk_keryx_first_pos(t, ggml_nrows(node)) : t.pos_base);
+        }
+    }
+    if (node->op == GGML_OP_FLASH_ATTN_EXT && t.lse) {
+        const int il = ggml_vk_keryx_layer_of(node->name, "__fattn__");
+        if (il < 0) {
+            ggml_vk_keryx_fail(t, std::string("attention node ") + node->name + " names no layer");
+            return;
+        }
+        ggml_vk_keryx_lse(ctx, subctx, t, node, (uint32_t) il);
+    }
+    if (node->op == GGML_OP_GATED_DELTA_NET && t.rec) {
+        const int il = ggml_vk_keryx_layer_of(node->name, "__gdn__");
+        if (il < 0) {
+            ggml_vk_keryx_fail(t, std::string("recurrent node ") + node->name + " names no layer");
+            return;
+        }
+        ggml_vk_keryx_recur(ctx, subctx, t, node, (uint32_t) il);
+    }
+    const int leaf = ggml_vk_keryx_resid_leaf(t, node->name);
+    if (leaf >= 0) {
+        ggml_vk_keryx_tensor_rows(ctx, subctx, t, node, leaf, ggml_vk_keryx_first_pos(t, ggml_nrows(node)));
+    }
+}
