+// ── Keryx zero-dup exports ──────────────────────────────────────────────────
+// Let an external Vulkan compute kernel in the same process (the Keryx PoM walk)
+// read weight tensors resident in this backend's VRAM instead of keeping its own
+// duplicate copy. Buffer device addresses are only dereferenceable on the device
+// that owns them, so the external kernel builds its pipeline on THIS VkDevice and
+// submits through the guarded submit hook below.
+
+bool ggml_backend_vk_keryx_raw_handles(size_t dev_num, void ** vk_instance_out,
+                                       void ** vk_physical_device, void ** vk_device_out,
+                                       uint32_t * compute_queue_family_index) {
+    try {
+        ggml_vk_instance_init();
+        if (dev_num >= vk_instance.device_indices.size()) {
+            return false;
+        }
+        vk_device dev = ggml_vk_get_device(vk_instance.device_indices[dev_num]);
+        if (!dev->buffer_device_address) {
+            return false; // no BDA → tensors cannot be reached by raw address
+        }
+        *vk_instance_out            = (void *) (VkInstance) vk_instance.instance;
+        *vk_physical_device         = (void *) (VkPhysicalDevice) dev->physical_device;
+        *vk_device_out              = (void *) (VkDevice) dev->device;
+        *compute_queue_family_index = dev->compute_queue->queue_family_index;
+        return true;
+    } catch (const vk::SystemError &) {
+        return false;
+    }
+}
+
+bool ggml_backend_vk_keryx_tensor_addr(const struct ggml_tensor * tensor,
+                                       uint64_t * gpu_addr, uint64_t * size_bytes) {
+    if (tensor == nullptr || tensor->buffer == nullptr || !ggml_backend_buffer_is_vk(tensor->buffer)) {
+        return false;
+    }
+    ggml_backend_vk_buffer_context * buf_ctx = (ggml_backend_vk_buffer_context *) tensor->buffer->context;
+    const vk_buffer & buf = buf_ctx->dev_buffer;
+    if (!buf || buf->bda_addr == 0) {
+        return false;
+    }
+    // Same resolution ggml_vk_tensor_subbuffer / the in-shader BDA paths use.
+    *gpu_addr   = buf->bda_addr + vk_tensor_offset(tensor) + tensor->view_offs;
+    *size_bytes = ggml_nbytes(tensor);
+    return true;
+}
+
+void ggml_backend_vk_keryx_queue_submit(size_t dev_num, const void * submit_info, void * fence) {
+    vk_device dev = ggml_vk_get_device(vk_instance.device_indices[dev_num]);
+    // The queue handle's own submit takes the lock every internal ggml_vk_submit takes (none
+    // when the queue is internally synchronized): external dispatches can never race ggml's own
+    // submissions on the shared compute queue.
+    dev->compute_queue->handle->submit({ *reinterpret_cast<const vk::SubmitInfo *>(submit_info) },
+                                       vk::Fence((VkFence) fence));
+}
+
+// ── Keryx canonical trace: control ─────────────────────────────────────────
+// Driven by the miner around a traced evaluation: configure once per manifest, then begin, announce
+// each batch before its decode, end, read. A replay arms its captures after begin. Every call returns
+// 0 on success and a negative code otherwise; ggml_backend_vk_keryx_trace_error explains the last
+// evaluation's failure.
+
+static vk_device ggml_vk_keryx_device(size_t dev_num) {
+    ggml_vk_instance_init();
+    if (dev_num >= vk_instance.device_indices.size()) {
+        return nullptr;
+    }
+    vk_device dev = ggml_vk_get_device(vk_instance.device_indices[dev_num]);
+    return dev && dev->idx < GGML_VK_MAX_DEVICES ? dev : nullptr;
+}
+
+// Product ranks, forms and the leaf layout of a serialized manifest (`KXMANIF1`/`KXMANIF2`).
+static bool ggml_vk_keryx_load_manifest(vk_keryx_trace & s, const uint8_t * b, size_t len) {
+    if (len < 16 || (memcmp(b, "KXMANIF1", 8) != 0 && memcmp(b, "KXMANIF2", 8) != 0)) {
+        return false;
+    }
+    const bool chain = b[7] == '2';
+    uint32_t n_entries, n_products;
+    memcpy(&n_entries, &b[8], 4);
+    memcpy(&n_products, &b[12], 4);
+    if (n_products == 0 || n_products > n_entries) {
+        return false;
+    }
+    uint32_t n_layers = 0;
+    bool moe = false;
+    size_t o = 16;
+    for (uint32_t i = 0; i < n_entries; ++i) {
+        if (o + 2 > len) {
+            return false;
+        }
+        uint16_t nl;
+        memcpy(&nl, &b[o], 2);
+        if (o + 2 + nl + 55 > len) {
+            return false;
+        }
+        std::string name((const char *) &b[o + 2], nl);
+        const uint8_t * r = &b[o + 2 + nl];
+        const uint8_t role = r[44], form = r[46];
+        uint32_t bias, wtype;
+        memcpy(&bias, &r[51], 4);
+        memcpy(&wtype, &r[0], 4);
+        if (i < n_products) {
+            s.rank[name] = (int) i;
+            s.prod.push_back({ form, bias == 0xFFFFFFFFu ? -1 : (int) bias, role == 2, wtype });
+        }
+        o += 2 + nl + 55;
+        if (chain) {
+            if (o >= len) {
+                return false;
+            }
+            // Layer tags: 2 plain, 3 routed, 4/5 with attention (21 fields), 6/7 recurrent (19 fields).
+            const uint8_t tag = b[o];
+            const size_t ext = tag == 0 ? 1 : tag == 1 ? 14 : tag == 2 ? 25 : tag == 3 ? 49 : tag == 4 ? 25 + 84 : tag == 5 ? 49 + 84 : tag == 6 ? 25 + 76 : tag == 7 ? 49 + 76 : 0;
+            if (ext == 0 || o + ext > len) {
+                return false;
+            }
+            if (tag >= 2) {
+                uint32_t layer;
+                memcpy(&layer, &b[o + 1], 4);
+                if (layer != n_layers) {
+                    return false;
+                }
+                n_layers++;
+                moe = moe || tag == 3 || tag == 5 || tag == 7;
+            }
+            o += ext;
+        }
+    }
+    s.n_products = n_products;
+    s.n_layers   = n_layers;
+    s.n_router   = moe ? n_layers : 0;
+    s.nl = 2 * n_products + 2 * n_layers + s.n_router + 1;
+    return true;
+}
+
+static vk_buffer ggml_vk_keryx_host_buffer(vk_device & dev, size_t size) {
+    return ggml_vk_create_buffer_check(dev, size, vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent | vk::MemoryPropertyFlagBits::eHostCached,
+                                       vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent);
+}
+
+int ggml_backend_vk_keryx_trace_configure(size_t dev_num, const void * manifest, size_t manifest_len, uint32_t max_pos) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev || !manifest || max_pos == 0) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace fresh;
+    if (!ggml_vk_keryx_load_manifest(fresh, (const uint8_t *) manifest, manifest_len)) {
+        return -4;
+    }
+    fresh.max_pos = max_pos;
+    try {
+        fresh.leaves = ggml_vk_keryx_host_buffer(dev, (size_t) max_pos * fresh.nl * 32);
+    } catch (const std::exception &) {
+        return -3;
+    }
+    if (!fresh.leaves || !fresh.leaves->ptr) {
+        return -3;
+    }
+    fresh.on = true;
+    vk_keryx_traces[dev->idx] = std::move(fresh);
+    return 0;
+}
+
+void ggml_backend_vk_keryx_trace_release(size_t dev_num) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_traces[dev->idx] = vk_keryx_trace();
+}
+
+int ggml_backend_vk_keryx_trace_leaf_count(size_t dev_num) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    const vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    return t.on ? (int) t.nl : -1;
+}
+
+int ggml_backend_vk_keryx_trace_max_pos(size_t dev_num) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    const vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    return t.on ? (int) t.max_pos : -1;
+}
+
+int ggml_backend_vk_keryx_trace_begin(size_t dev_num) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.on) {
+        return -1;
+    }
+    memset(t.leaves->ptr, 0, t.leaves->size);
+    t.ubatch.assign(t.max_pos, 0);
+    t.pos_base = t.n_tokens = t.n_pos = 0;
+    t.declared = 0;
+    if (t.lse) {
+        // An unwritten mass reads back as NaN, never as a value.
+        std::fill_n((float *) t.lse->ptr, t.lse->size / 4, std::numeric_limits<float>::quiet_NaN());
+    }
+    t.cap_list.clear();
+    t.cap_len.clear();
+    t.cap_slot = 0;
+    t.error.clear();
+    t.armed = true;
+    return 0;
+}
+
+int ggml_backend_vk_keryx_trace_ubatch(size_t dev_num, uint32_t pos_base, uint32_t n_tokens) {
+    return ggml_backend_vk_keryx_trace_ubatch_as(dev_num, pos_base, n_tokens, n_tokens);
+}
+
+int ggml_backend_vk_keryx_trace_ubatch_as(size_t dev_num, uint32_t pos_base, uint32_t n_tokens, uint32_t n_ubatch) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.armed || n_tokens == 0 || n_ubatch < n_tokens) {
+        return -1;
+    }
+    if ((uint64_t) pos_base + n_tokens > t.max_pos) {
+        ggml_vk_keryx_fail(t, "the evaluation passes the " + std::to_string(t.max_pos) + " traced positions");
+        return -5;
+    }
+    if (t.rec) {
+        // Checkpoints are the states after whole intervals: one may only end a batch.
+        const uint64_t end = (uint64_t) pos_base + n_tokens;
+        const uint64_t crossed = end / t.rec_interval - pos_base / t.rec_interval;
+        if (n_tokens > VK_KERYX_REC_TOKENS || crossed > 1 || (crossed == 1 && end % t.rec_interval != 0)) {
+            ggml_vk_keryx_fail(t, "a batch of " + std::to_string(n_tokens) + " tokens at " + std::to_string(pos_base) + " splits a checkpoint interval");
+            return -5;
+        }
+        t.rec_ckpt_due = crossed == 1;
+        std::fill(t.rec_seen.begin(), t.rec_seen.end(), 0);
+    }
+    t.pos_base = pos_base;
+    t.n_tokens = n_tokens;
+    t.declared = n_ubatch;
+    for (uint32_t p = pos_base; p < pos_base + n_tokens; ++p) {
+        t.ubatch[p] = n_ubatch;
+    }
+    t.n_pos = std::max(t.n_pos, pos_base + n_tokens);
+    return 0;
+}
+
+int ggml_backend_vk_keryx_trace_end(size_t dev_num) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return -1;
+    }
+    {
+        // Every dispatch of the evaluation has landed before its leaves are read. The queue handle's
+        // lock (a no-op on an internally synchronized queue) keeps the wait off concurrent submits.
+        vk_queue_handle & h = *dev->compute_queue->handle;
+        std::lock_guard<vk_queue_handle> q(h);
+        h.queue.waitIdle();
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    t.armed = false;
+    return t.error.empty() ? 0 : -9;
+}
+
+int ggml_backend_vk_keryx_trace_read(size_t dev_num, uint8_t * leaves, size_t leaves_cap, uint32_t * ubatch, size_t ubatch_cap,
+                                     uint32_t * n_pos) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev || !n_pos) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    const vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.on) {
+        return -1;
+    }
+    *n_pos = t.n_pos;
+    if (!t.error.empty()) {
+        return -9;
+    }
+    if (!leaves || !ubatch) {
+        return 0;
+    }
+    const size_t need = (size_t) t.n_pos * t.nl * 32;
+    if (leaves_cap < need || ubatch_cap < t.n_pos) {
+        return -6;
+    }
+    memcpy(leaves, t.leaves->ptr, need);
+    memcpy(ubatch, t.ubatch.data(), (size_t) t.n_pos * 4);
+    return 0;
+}
+
+int ggml_backend_vk_keryx_trace_arm_captures(size_t dev_num, const uint32_t * pos, const uint32_t * leaf, uint32_t n, uint32_t slot_bytes) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev || !pos || !leaf || n == 0 || n > 64 || slot_bytes == 0 || slot_bytes % 4 != 0) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.armed) {
+        return -1;
+    }
+    const size_t need = (size_t) n * slot_bytes;
+    if (!t.caps || t.caps->size < need) {
+        t.caps.reset();
+        try {
+            t.caps = ggml_vk_keryx_host_buffer(dev, need);
+        } catch (const std::exception &) {
+            return -3;
+        }
+        if (!t.caps || !t.caps->ptr) {
+            t.caps.reset();
+            return -3;
+        }
+    }
+    t.cap_list.clear();
+    for (uint32_t k = 0; k < n; ++k) {
+        t.cap_list.push_back({ pos[k], leaf[k] });
+    }
+    t.cap_len.assign(n, 0);
+    t.cap_slot = slot_bytes;
+    return 0;
+}
+
+int ggml_backend_vk_keryx_trace_read_captures(size_t dev_num, uint8_t * out, size_t out_cap, uint32_t * lens, uint32_t n) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev || !out || !lens) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (n == 0 || n != t.cap_list.size()) {
+        return -1;
+    }
+    int rc = t.error.empty() ? 0 : -9;
+    for (uint32_t k = 0; k < n; ++k) {
+        lens[k] = t.cap_len[k];
+        const size_t off = (size_t) k * t.cap_slot;
+        if (t.cap_len[k] == 0) {
+            rc = rc ? rc : -7;
+        } else if (off + t.cap_len[k] > out_cap) {
+            rc = rc ? rc : -6;
+        } else {
+            memcpy(out + off, (const uint8_t *) t.caps->ptr + off, t.cap_len[k]);
+        }
+    }
+    t.cap_list.clear();
+    t.cap_len.clear();
+    return rc;
+}
+
+int ggml_backend_vk_keryx_recur_configure(size_t dev_num, const uint32_t * layers, uint32_t n, uint32_t interval) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev || (n > 0 && (!layers || interval == 0))) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.on || t.armed) {
+        return -1;
+    }
+    t.rec.reset();
+    t.rec_ckpt.reset();
+    t.rec_slot.clear();
+    t.rec_seen.clear();
+    t.rec_n = t.rec_heads = t.rec_dim = t.rec_kda = t.rec_bytes = t.rec_interval = 0;
+    if (n == 0) {
+        return 0;
+    }
+    // Rows of (layer, kind, slot, heads, head_dim); kind 3 = one decay per head, 4 = per key
+    // dimension. Every recurrent layer has the same heads and dimension.
+    const uint32_t kind = layers[1], heads = layers[3], dim = layers[4];
+    if ((kind != 3 && kind != 4) || heads == 0 || dim == 0 || dim > 128 || dim % 32 != 0) {
+        return -2;
+    }
+    std::vector<int> slot_of;
+    for (uint32_t i = 0; i < n; ++i) {
+        const uint32_t * r = layers + 5 * i;
+        if (r[1] != kind || r[3] != heads || r[4] != dim || r[2] >= n || r[0] >= 0x10000) {
+            return -2;
+        }
+        if (r[0] >= slot_of.size()) {
+            slot_of.resize(r[0] + 1, -1);
+        }
+        slot_of[r[0]] = (int) r[2];
+    }
+    const uint32_t rec_bytes = 8 * dim + 4 + (kind == 4 ? 2 * dim : 4);
+    try {
+        t.rec = ggml_vk_keryx_host_buffer(dev, (size_t) n * heads * VK_KERYX_REC_TOKENS * rec_bytes);
+        t.rec_ckpt = ggml_vk_keryx_host_buffer(dev, (size_t) n * heads * dim * dim * 4);
+    } catch (const std::exception &) {
+        t.rec.reset();
+        t.rec_ckpt.reset();
+        return -3;
+    }
+    if (!t.rec || !t.rec->ptr || !t.rec_ckpt || !t.rec_ckpt->ptr) {
+        t.rec.reset();
+        t.rec_ckpt.reset();
+        return -3;
+    }
+    t.rec_slot = std::move(slot_of);
+    t.rec_seen.assign(n, 0);
+    t.rec_n = n;
+    t.rec_heads = heads;
+    t.rec_dim = dim;
+    t.rec_kda = kind == 4 ? 1 : 0;
+    t.rec_bytes = rec_bytes;
+    t.rec_interval = interval;
+    return 0;
+}
+
+int ggml_backend_vk_keryx_recur_read(size_t dev_num, uint8_t * rec, size_t rec_cap, uint8_t * ckpt, size_t ckpt_cap, uint32_t * n_tokens, uint32_t * has_ckpt) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev || !rec || !n_tokens || !has_ckpt) {
+        return -1;
+    }
+    {
+        // The batch's dispatches have all landed before its records are read.
+        vk_queue_handle & h = *dev->compute_queue->handle;
+        std::lock_guard<vk_queue_handle> q(h);
+        h.queue.waitIdle();
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.armed || !t.rec) {
+        return -1;
+    }
+    if (!t.error.empty()) {
+        return -9;
+    }
+    for (uint32_t s = 0; s < t.rec_n; ++s) {
+        if (!t.rec_seen[s]) {
+            ggml_vk_keryx_fail(t, "recurrent layer " + std::to_string(s) + " left no record of the batch at " + std::to_string(t.pos_base));
+            return -9;
+        }
+    }
+    const size_t per = (size_t) t.n_tokens * t.rec_bytes;
+    const size_t heads = (size_t) t.rec_n * t.rec_heads;
+    const size_t state = (size_t) t.rec_dim * t.rec_dim * 4;
+    if (rec_cap < heads * per || (t.rec_ckpt_due && (!ckpt || ckpt_cap < heads * state))) {
+        return -6;
+    }
+    for (size_t i = 0; i < heads; ++i) {
+        memcpy(rec + i * per, (const uint8_t *) t.rec->ptr + i * VK_KERYX_REC_TOKENS * t.rec_bytes, per);
+    }
+    if (t.rec_ckpt_due) {
+        memcpy(ckpt, t.rec_ckpt->ptr, heads * state);
+    }
+    *n_tokens = t.n_tokens;
+    *has_ckpt = t.rec_ckpt_due ? 1 : 0;
+    return 0;
+}
+
+int ggml_backend_vk_keryx_lse_configure(size_t dev_num, uint32_t n_layers, uint32_t n_heads) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.on || t.armed) {
+        return -1;
+    }
+    if (n_layers == 0 || n_heads == 0) {
+        t.lse.reset();
+        t.lse_layers = t.lse_heads = 0;
+        return 0;
+    }
+    if (t.lse && t.lse_layers == n_layers && t.lse_heads == n_heads) {
+        return 0;
+    }
+    t.lse.reset();
+    t.lse_layers = t.lse_heads = 0;
+    try {
+        t.lse = ggml_vk_keryx_host_buffer(dev, (size_t) n_layers * t.max_pos * n_heads * 4);
+    } catch (const std::exception &) {
+        t.lse.reset();
+        return -3;
+    }
+    if (!t.lse || !t.lse->ptr) {
+        t.lse.reset();
+        return -3;
+    }
+    t.lse_layers = n_layers;
+    t.lse_heads = n_heads;
+    return 0;
+}
+
+int ggml_backend_vk_keryx_lse_read(size_t dev_num, float * out, size_t out_cap, uint32_t n_pos) {
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev || !out) {
+        return -1;
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    const vk_keryx_trace & t = vk_keryx_traces[dev->idx];
+    if (!t.on || !t.lse || t.armed || n_pos > t.max_pos) {
+        return -1;
+    }
+    if (!t.error.empty()) {
+        return -9;
+    }
+    const size_t row = (size_t) n_pos * t.lse_heads;
+    if (out_cap < (size_t) t.lse_layers * row) {
+        return -6;
+    }
+    for (uint32_t l = 0; l < t.lse_layers; ++l) {
+        memcpy(out + l * row, (const float *) t.lse->ptr + (size_t) l * t.max_pos * t.lse_heads, row * 4);
+    }
+    return 0;
+}
+
+const char * ggml_backend_vk_keryx_trace_error(size_t dev_num) {
+    static thread_local std::string last;
+    vk_device dev = ggml_vk_keryx_device(dev_num);
+    if (!dev) {
+        return "no such Vulkan device";
+    }
+    std::lock_guard<std::mutex> g(vk_keryx_mutex);
+    last = vk_keryx_traces[dev->idx].error;
+    return last.c_str();
+}
