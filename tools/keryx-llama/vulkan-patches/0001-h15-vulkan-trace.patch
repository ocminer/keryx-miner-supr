diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/keryx_lse.comp b/ggml/src/ggml-vulkan/vulkan-shaders/keryx_lse.comp
new file mode 100644
index 0000000..d82a6e1
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/keryx_lse.comp
@@ -0,0 +1,112 @@
+#version 450
+
+// Keryx canonical trace (verifiable inference, attention rule): the log softmax mass of every
+// query row and head of a flash-attention node, log(sum_j exp(scale * q.k_j + mask_j)), over the
+// node's own inputs: the f32 queries, the q8_0 key cache view and the f16 mask. One workgroup per
+// (query row, head); each invocation folds a strided share of the keys into a running maximum and
+// sum, then the shares are merged.
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Q { float q[]; };
+layout(binding = 1) readonly buffer K { uint k[]; };
+layout(binding = 2) readonly buffer M { uint m[]; };
+layout(binding = 3) writeonly buffer O { float o[]; };
+
+layout(push_constant) uniform parameter {
+    uint q_off;     // float offset of query row 0, head 0
+    uint q_row;     // floats between query rows
+    uint q_head;    // floats between query heads
+    uint k_off;     // byte offset of key 0, key head 0
+    uint k_row;     // bytes between keys
+    uint k_head;    // bytes between key heads
+    uint m_off;     // f16 offset of the mask row of query 0 (has_mask)
+    uint m_row;     // f16 values between mask rows
+    uint has_mask;
+    uint n_kv;
+    uint dim;       // head dimension, a multiple of 32
+    uint gqa;       // query heads per key head
+    float scale;
+    uint o_off;     // float offset of query row 0, head 0 in o
+    uint o_row;     // floats between query rows in o
+} p;
+
+shared float sh_max[64];
+shared float sh_sum[64];
+
+uint byte_at(uint off) {
+    return (k[off >> 2] >> ((off & 3u) * 8u)) & 0xFFu;
+}
+
+float key_dot(uint row, uint h) {
+    const uint qb = p.q_off + gl_WorkGroupID.x * p.q_row + h * p.q_head;
+    const uint kb = p.k_off + row * p.k_row + (h / p.gqa) * p.k_head;
+    float acc = 0.0;
+    for (uint b = 0u; b < p.dim / 32u; b++) {
+        const uint bo = kb + 34u * b;
+        const float d = unpackHalf2x16(byte_at(bo) | (byte_at(bo + 1u) << 8u)).x;
+        float s = 0.0;
+        for (uint i = 0u; i < 32u; i++) {
+            const int v = int(byte_at(bo + 2u + i) << 24u) >> 24;
+            s += q[qb + 32u * b + i] * float(v);
+        }
+        acc += d * s;
+    }
+    return acc;
+}
+
+float mask_at(uint j) {
+    if (p.has_mask == 0u) {
+        return 0.0;
+    }
+    const uint e = p.m_off + gl_WorkGroupID.x * p.m_row + j;
+    const vec2 pair = unpackHalf2x16(m[e >> 1]);
+    return (e & 1u) == 0u ? pair.x : pair.y;
+}
+
+void main() {
+    const uint h = gl_WorkGroupID.y;
+    const uint tid = gl_LocalInvocationID.x;
+    const float NEG_INF = uintBitsToFloat(0xFF800000u);
+
+    float mx = NEG_INF;
+    float sum = 0.0;
+    for (uint j = tid; j < p.n_kv; j += 64u) {
+        const float mk = mask_at(j);
+        if (isinf(mk) && mk < 0.0) {
+            continue;
+        }
+        const float s = p.scale * key_dot(j, h) + mk;
+        if (s > mx) {
+            sum = sum * exp(mx - s) + 1.0;
+            mx = s;
+        } else {
+            sum += exp(s - mx);
+        }
+    }
+    sh_max[tid] = mx;
+    sh_sum[tid] = sum;
+    barrier();
+    for (uint w = 32u; w > 0u; w >>= 1u) {
+        if (tid < w) {
+            const float m0 = sh_max[tid], m1 = sh_max[tid + w];
+            const float s0 = sh_sum[tid], s1 = sh_sum[tid + w];
+            const float mm = max(m0, m1);
+            float s = 0.0;
+            if (s0 > 0.0) {
+                s += s0 * exp(m0 - mm);
+            }
+            if (s1 > 0.0) {
+                s += s1 * exp(m1 - mm);
+            }
+            sh_max[tid] = mm;
+            sh_sum[tid] = s;
+        }
+        barrier();
+    }
+    if (tid == 0u) {
+        o[p.o_off + gl_WorkGroupID.x * p.o_row + h] = sh_sum[0] > 0.0 ? sh_max[0] + log(sh_sum[0]) : NEG_INF;
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/keryx_rec.comp b/ggml/src/ggml-vulkan/vulkan-shaders/keryx_rec.comp
new file mode 100644
index 0000000..dde23a9
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/keryx_rec.comp
@@ -0,0 +1,71 @@
+#version 450
+
+// Keryx canonical trace (verifiable inference, attention rule): the delta-rule record of every
+// head of a fused gated-delta-net node at every token of the batch, from the node's own inputs and
+// output: q, k, v and the output o (before the gated norm) as f16, beta as f32, then the log decay g
+// as f32 (one per head) or f16 (one per key dimension, KDA). The node reads query/key head
+// `h % H_k` for value head `h`, and its g shares beta's strides. One workgroup per (head, token);
+// record `(h, t)` lands at word `out_off + (h * t_stride + t) * rec_words`.
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Q { float q[]; };
+layout(binding = 1) readonly buffer K { float k[]; };
+layout(binding = 2) readonly buffer V { float v[]; };
+layout(binding = 3) readonly buffer G { float g[]; };
+layout(binding = 4) readonly buffer B { float beta[]; };
+layout(binding = 5) readonly buffer O { float o[]; };
+layout(binding = 6) writeonly buffer R { uint r[]; };
+
+layout(push_constant) uniform parameter {
+    uint q_off;     // float offsets of the first element of each binding's tensor
+    uint k_off;
+    uint v_off;
+    uint g_off;
+    uint b_off;
+    uint o_off;
+    uint sq1;       // floats between query/key heads
+    uint sq2;       // floats between query/key tokens
+    uint sv1;       // floats between value heads
+    uint sv2;       // floats between value tokens
+    uint sb1;       // floats between beta/g heads
+    uint sb2;       // floats between beta/g tokens
+    uint H;         // value heads
+    uint H_k;       // query/key heads
+    uint S;         // head dimension (even)
+    uint kda;
+    uint rec_words;
+    uint out_off;
+    uint t_stride;
+} p;
+
+void main() {
+    const uint h = gl_WorkGroupID.x;
+    const uint t = gl_WorkGroupID.y;
+    const uint hk = h % p.H_k;
+    const uint qb = p.q_off + t * p.sq2 + hk * p.sq1;
+    const uint kb = p.k_off + t * p.sq2 + hk * p.sq1;
+    const uint vb = p.v_off + t * p.sv2 + h * p.sv1;
+    const uint ob = p.o_off + (t * p.H + h) * p.S;
+    const uint gb = t * p.sb2 + h * p.sb1;
+    const uint base = p.out_off + (h * p.t_stride + t) * p.rec_words;
+    const uint half_s = p.S / 2;
+    for (uint i = gl_LocalInvocationID.x; i < half_s; i += 64) {
+        r[base + i]              = packHalf2x16(vec2(q[qb + 2 * i], q[qb + 2 * i + 1]));
+        r[base + half_s + i]     = packHalf2x16(vec2(k[kb + 2 * i], k[kb + 2 * i + 1]));
+        r[base + 2 * half_s + i] = packHalf2x16(vec2(v[vb + 2 * i], v[vb + 2 * i + 1]));
+        r[base + 3 * half_s + i] = packHalf2x16(vec2(o[ob + 2 * i], o[ob + 2 * i + 1]));
+        if (p.kda != 0) {
+            const uint gi = p.g_off + gb * p.S + 2 * i;
+            r[base + 2 * p.S + 1 + i] = packHalf2x16(vec2(g[gi], g[gi + 1]));
+        }
+    }
+    if (gl_LocalInvocationID.x == 0) {
+        r[base + 2 * p.S] = floatBitsToUint(beta[p.b_off + gb]);
+        if (p.kda == 0) {
+            r[base + 2 * p.S + 1] = floatBitsToUint(g[p.g_off + gb]);
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/keryx_trace.comp b/ggml/src/ggml-vulkan/vulkan-shaders/keryx_trace.comp
new file mode 100644
index 0000000..c17f136
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/keryx_trace.comp
@@ -0,0 +1,212 @@
+#version 450
+
+// Keryx canonical trace (verifiable inference): BLAKE3 of each row of a captured tensor, written to
+// its leaf in the trace, or — in copy mode — the canonical bytes of one row, for an opening.
+//
+// A row is read in its canonical byte form:
+//   KIND_ROWS: the row's own words (f32 outputs and residuals);
+//   KIND_Q8:   a q8_1 activation row held as block_q8_1_x4 groups (4 x f16vec2 ds, then 128 int8),
+//              re-laid as 36-byte block_q8_1 (ds, 32 int8) blocks, zero blocks past `k_blocks` (the
+//              row is padded to a multiple of 512 values, as CUDA's MMVQ layout is);
+//   KIND_Q8_D4 / KIND_Q8_DS4: the same row in CUDA's MMQ layouts (block_q8_1_mmq: four f32
+//              scales, or four f16 (d, s) pairs, then 128 int8), as a prompt position committed
+//              in a batch of more than 8 tokens carries it.
+// One workgroup hashes one row: each invocation compresses whole 1 KiB chunks, then the chunk
+// chaining values are folded pairwise (an odd last node carries up), which is BLAKE3's tree.
+
+#extension GL_EXT_control_flow_attributes : require
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Src { uint src[]; };
+layout(binding = 1) buffer Leaves { uint leaves[]; };
+layout(binding = 2) writeonly buffer Cap { uint cap[]; };
+
+layout(push_constant) uniform parameter {
+    uint src_off;     // word offset of row 0 in src
+    uint row_stride;  // words between consecutive rows in src
+    uint row_bytes;   // canonical bytes per row (a multiple of 4)
+    uint kind;        // KIND_ROWS or KIND_Q8, | COPY_MODE
+    uint k_blocks;    // KIND_Q8: real 32-value blocks per row
+    uint first_pos;   // trace position of row 0
+    uint nl;          // leaves per position
+    uint leaf_a;      // leaf index, NO_LEAF for none
+    uint leaf_b;
+    uint cap_row;     // COPY_MODE: the row copied
+    uint cap_off;     // COPY_MODE: word offset in cap
+} p;
+
+#define KIND_ROWS 0u
+#define KIND_Q8 1u
+#define KIND_Q8_D4 2u
+#define KIND_Q8_DS4 3u
+#define COPY_MODE 0x100u
+#define NO_LEAF 0xFFFFFFFFu
+#define MAX_CHUNKS 1024u
+
+#define CHUNK_START 1u
+#define CHUNK_END 2u
+#define PARENT 4u
+#define ROOT 8u
+
+const uint IV[8] = uint[8](0x6A09E667u, 0xBB67AE85u, 0x3C6EF372u, 0xA54FF53Au,
+                           0x510E527Fu, 0x9B05688Cu, 0x1F83D9ABu, 0x5BE0CD19u);
+
+shared uint cvs[MAX_CHUNKS * 8u];
+
+uint rotr(uint x, uint n) {
+    return (x >> n) | (x << (32u - n));
+}
+
+#define G(a, b, c, d, mx, my) \
+    v[a] += v[b] + (mx); v[d] = rotr(v[d] ^ v[a], 16u); \
+    v[c] += v[d];        v[b] = rotr(v[b] ^ v[c], 12u); \
+    v[a] += v[b] + (my); v[d] = rotr(v[d] ^ v[a], 8u);  \
+    v[c] += v[d];        v[b] = rotr(v[b] ^ v[c], 7u)
+
+void compress(inout uint cv[8], uint m[16], uint counter, uint block_len, uint flags) {
+    uint v[16];
+    [[unroll]] for (uint i = 0u; i < 8u; i++) {
+        v[i] = cv[i];
+    }
+    v[8] = IV[0]; v[9] = IV[1]; v[10] = IV[2]; v[11] = IV[3];
+    v[12] = counter; v[13] = 0u; v[14] = block_len; v[15] = flags;
+    [[unroll]] for (uint r = 0u; r < 7u; r++) {
+        G(0, 4, 8, 12, m[0], m[1]);
+        G(1, 5, 9, 13, m[2], m[3]);
+        G(2, 6, 10, 14, m[4], m[5]);
+        G(3, 7, 11, 15, m[6], m[7]);
+        G(0, 5, 10, 15, m[8], m[9]);
+        G(1, 6, 11, 12, m[10], m[11]);
+        G(2, 7, 8, 13, m[12], m[13]);
+        G(3, 4, 9, 14, m[14], m[15]);
+        if (r < 6u) {
+            const uint t[16] = uint[16](m[2], m[6], m[3], m[10], m[7], m[0], m[4], m[13],
+                                        m[1], m[11], m[12], m[5], m[9], m[14], m[15], m[8]);
+            m = t;
+        }
+    }
+    [[unroll]] for (uint i = 0u; i < 8u; i++) {
+        cv[i] = v[i] ^ v[i + 8u];
+    }
+}
+
+// Word `wi` (0: the scale pair, 1..8: the values) of block `b` of q8_1 row `row`, read from the
+// x4 groups; zero past `k_blocks`.
+uint q8_word(uint row, uint b, uint wi) {
+    if (b >= p.k_blocks) {
+        return 0u;
+    }
+    // The rows were quantized as one flat array: block `b` of row `row` is block
+    // `row * k_blocks + b` of it, wherever the x4 groups fall.
+    const uint fb = row * p.k_blocks + b;
+    const uint g = p.src_off + (fb >> 2) * 36u;
+    const uint j = fb & 3u;
+    return wi == 0u ? src[g + j] : src[g + 4u + 8u * j + wi - 1u];
+}
+
+// Canonical word `w` of row `row`.
+uint word(uint row, uint w) {
+    const uint base = p.src_off + row * p.row_stride;
+    const uint kind = p.kind & 0xFFu;
+    if (kind == KIND_ROWS) {
+        return src[base + w];
+    }
+    if (kind == KIND_Q8_D4 || kind == KIND_Q8_DS4) {
+        // CUDA's MMQ layouts: 144-byte groups of four blocks, their four scales first (f32 d, or
+        // the f16 pair d and s), then the 128 values.
+        const uint gi = w / 36u;
+        const uint wi = w - 36u * gi;
+        if (wi < 4u) {
+            const uint ds = q8_word(row, 4u * gi + wi, 0u);
+            return kind == KIND_Q8_D4 ? floatBitsToUint(unpackHalf2x16(ds).x) : ds;
+        }
+        return q8_word(row, 4u * gi + (wi - 4u) / 8u, 1u + (wi - 4u) % 8u);
+    }
+    const uint b = w / 9u;
+    return q8_word(row, b, w - 9u * b);
+}
+
+void main() {
+    const uint row = gl_WorkGroupID.x;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint n_words = p.row_bytes / 4u;
+
+    if ((p.kind & COPY_MODE) != 0u) {
+        for (uint w = tid; w < n_words; w += 64u) {
+            cap[p.cap_off + w] = word(p.cap_row, w);
+        }
+        return;
+    }
+
+    const uint nch = (p.row_bytes + 1023u) / 1024u;
+    for (uint c = tid; c < nch; c += 64u) {
+        uint cv[8] = IV;
+        const uint len = min(1024u, p.row_bytes - c * 1024u);
+        const uint nblk = (len + 63u) / 64u;
+        for (uint b = 0u; b < nblk; b++) {
+            const uint blen = min(64u, len - b * 64u);
+            uint m[16];
+            [[unroll]] for (uint i = 0u; i < 16u; i++) {
+                m[i] = 4u * i < blen ? word(row, c * 256u + b * 16u + i) : 0u;
+            }
+            const bool last = b + 1u == nblk;
+            const uint flags = (b == 0u ? CHUNK_START : 0u) | (last ? CHUNK_END : 0u) | (last && nch == 1u ? ROOT : 0u);
+            compress(cv, m, c, blen, flags);
+        }
+        [[unroll]] for (uint i = 0u; i < 8u; i++) {
+            cvs[c * 8u + i] = cv[i];
+        }
+    }
+    barrier();
+
+    // Each level: every parent is computed into registers before any is written back over the
+    // pairs (an invocation folds at most MAX_CHUNKS / 2 / 64 = 8 of them), then an odd last node
+    // carries up.
+    uint n = nch;
+    while (n > 1u) {
+        const uint half_n = n / 2u;
+        uint outs[8][8];
+        [[unroll]] for (uint s = 0u; s < 8u; s++) {
+            const uint i = tid + 64u * s;
+            if (i < half_n) {
+                uint m[16];
+                [[unroll]] for (uint k = 0u; k < 8u; k++) {
+                    m[k] = cvs[(2u * i) * 8u + k];
+                    m[8u + k] = cvs[(2u * i + 1u) * 8u + k];
+                }
+                uint cv[8] = IV;
+                compress(cv, m, 0u, 64u, PARENT | (n == 2u ? ROOT : 0u));
+                outs[s] = cv;
+            }
+        }
+        barrier();
+        [[unroll]] for (uint s = 0u; s < 8u; s++) {
+            const uint i = tid + 64u * s;
+            if (i < half_n) {
+                [[unroll]] for (uint k = 0u; k < 8u; k++) {
+                    cvs[i * 8u + k] = outs[s][k];
+                }
+            }
+        }
+        if (tid == 0u && (n & 1u) != 0u) {
+            [[unroll]] for (uint k = 0u; k < 8u; k++) {
+                cvs[half_n * 8u + k] = cvs[(n - 1u) * 8u + k];
+            }
+        }
+        barrier();
+        n = half_n + (n & 1u);
+    }
+
+    if (tid == 0u) {
+        const uint pos = p.first_pos + row;
+        [[unroll]] for (uint k = 0u; k < 8u; k++) {
+            if (p.leaf_a != NO_LEAF) {
+                leaves[(pos * p.nl + p.leaf_a) * 8u + k] = cvs[k];
+            }
+            if (p.leaf_b != NO_LEAF) {
+                leaves[(pos * p.nl + p.leaf_b) * 8u + k] = cvs[k];
+            }
+        }
+    }
+}
