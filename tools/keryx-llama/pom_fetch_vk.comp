#version 460
// Chunk-fetch verifier for the zero-dup walk: reads a RANGE of canonical 32-byte chunks through
// the EXACT prefix-table + buffer-device-address path pom_walk_vk.comp gathers with, so the host
// can byte-compare them against the possession index / on-disk GGUF — the startup byte gate (a
// handful of sampled chunks) and the full-model spike sweep both go through here.
// One invocation = one chunk: out[idx*4 .. idx*4+4] = chunk (first_chunk + idx).
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64) in;

layout(std430, buffer_reference, buffer_reference_align = 8) readonly buffer Tensor {
    uint64_t words[];
};

layout(std430, binding = 0) writeonly buffer Out { uint64_t w[]; } OUT;
layout(std430, binding = 1) readonly buffer Table { uint64_t prefix[]; } PREFIX;
layout(std430, binding = 2) readonly buffer Addrs { uint64_t addr[]; } ADDRS;

layout(push_constant) uniform Push {
    uint64_t first_chunk;
    uint     count;
    uint     n_tensors;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) {
        return;
    }
    uint64_t off = pc.first_chunk + uint64_t(idx);
    uint lo = 0u, hi = pc.n_tensors;
    while (hi - lo > 1u) {
        uint mid = (lo + hi) / 2u;
        if (PREFIX.prefix[mid] <= off) { lo = mid; } else { hi = mid; }
    }
    Tensor chunk = Tensor(ADDRS.addr[lo] + (off - PREFIX.prefix[lo]) * 32UL);
    OUT.w[idx * 4u]      = chunk.words[0];
    OUT.w[idx * 4u + 1u] = chunk.words[1];
    OUT.w[idx * 4u + 2u] = chunk.words[2];
    OUT.w[idx * 4u + 3u] = chunk.words[3];
}
