void main() {
    const uint lid  = gl_LocalInvocationID.x;
    const uint sub  = lid >> 5;              // sub-nonce 0..7 within the group
    const uint lane = lid & 31u;             // state row 0..31 within the sub-nonce
    const uint gsub = gl_WorkGroupID.x * V4_NPG + sub;
    // Sub-nonces past the batch still execute the walk with a dummy nonce (uniform barriers —
    // every lane must reach every workgroup barrier); they just never submit.
    const bool live  = gsub < pc.batch;
    const uint64_t nonce = pc.start_nonce + (live ? uint64_t(gsub) : 0UL);
    const uint64_t seed  = seed_fold_era(nonce);
    const uint strip = sub * V4_SP_STRIP_U32; // this sub-nonce's tile/leaves + Merkle level
    const bool lds_table = mirror_prefix_table(lid, 256u);

    uint row4[V4_D4];
    initial_row(seed, lane, row4);
    uint64_t off = mod_tiles(mix64(seed ^ V4_OFFSET_FIRST_SALT));

    for (uint step = 1u; step <= pc.k; ++step) {
        // Load this sub-nonce's 1 KB tile: lane loads canonical chunk (tile*32 + lane). Chunks are
        // located individually, so a tile that straddles two tensors is gathered exactly.
        load_chunk(off * uint64_t(V4_TILE_CHUNKS) + uint64_t(lane), strip + lane * V4_D4, lds_table);
        memoryBarrierShared();
        barrier();

        // The final transition has no successor tile. Skip its serial snippet fold and modulo.
        if (step < pc.k) {
            uint64_t sf = 0UL;
            [[unroll]] for (uint w = 0u; w < 8u; ++w) sf = mix64(sf ^ uint64_t(scratch[strip + w]));
            off = mod_tiles(mix64(seed ^ (uint64_t(step + 1u) * V4_OFFSET_STEP_SALT) ^ sf));
        }

        transition(row4, strip, step, lane);
        memoryBarrierShared();
        barrier();   // all lanes done with the tile before step+1 overwrites it
    }

    finish(row4, strip, lane, gsub, live);
}
#endif
