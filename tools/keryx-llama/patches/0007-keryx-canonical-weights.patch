 #include <string>
 #include <vector>
 
+#include <algorithm>
+#include <unordered_map>
+#include <unordered_set>
+
+// keryx: canonical weight layout. When set (by the miner's engine, before loading), a model's weights
+// on a non-host (GPU) buffer type are placed so that every GGUF tensor's whole 32-byte chunks sit back
+// to back in name order — the PoM walk's canonical stream — inside ONE buffer, so the walk can address
+// tile t at base + t KiB with no lookup. Tensors of the stream that this buffer does not hold (kept on
+// the host, or in another context) leave a zeroed hole the miner fills; tensors that are not part of
+// the stream (fewer than 32 bytes, not whole chunks, or a second tensor of the same name) go after it.
+// A zeroed slack after the stream absorbs the last tensor's row padding.
+extern "C" {
+bool   keryx_llama_canonical_weights = false;
+void * keryx_llama_canonical_base    = nullptr;  // last canonical buffer's base (device address)
+size_t keryx_llama_canonical_bytes   = 0;        // bytes of the canonical stream at that base
+}
+
+static ggml_backend_buffer_t keryx_canonical_alloc(const llama_model_loader & ml, ggml_context * ctx, ggml_backend_buffer_type_t buft) {
+    std::unordered_map<std::string, std::pair<size_t, size_t>> canon;   // name -> (offset, bytes)
+    size_t total = 0;
+    std::vector<std::pair<std::string, size_t>> names;                   // canonical = bytewise name order
+    for (const auto & [name, w] : ml.weights_map) names.emplace_back(name, ggml_nbytes(w.tensor));
+    std::sort(names.begin(), names.end());                               // char_traits<char>: unsigned bytes
+    for (const auto & [name, nb] : names) {
+        const size_t whole = nb / 32 * 32;
+        if (whole == 0) continue;
+        canon.emplace(name, std::make_pair(total, nb));
+        total += whole;
+    }
+    const size_t align = std::max<size_t>(ggml_backend_buft_get_alignment(buft), 32);
+    size_t max_pad = 0;
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+        max_pad = std::max(max_pad, ggml_backend_buft_get_alloc_size(buft, t) - ggml_nbytes(t));
+    }
+    const size_t slack = GGML_PAD(std::max<size_t>(max_pad, 64 * 1024), align);
+    const size_t extra0 = GGML_PAD(total, align) + slack;
+    std::unordered_set<std::string> placed;
+    std::vector<std::pair<ggml_tensor *, size_t>> where;
+    size_t extra = extra0;
+    for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+        const std::string name = ggml_get_name(t);
+        const size_t nb = ggml_nbytes(t);
+        auto it = canon.find(name);
+        if (it != canon.end() && it->second.second == nb && nb % 32 == 0 && placed.insert(name).second) {
+            where.emplace_back(t, it->second.first);
+        } else {
+            extra = GGML_PAD(extra, align);
+            where.emplace_back(t, extra);
+            extra += ggml_backend_buft_get_alloc_size(buft, t);
+        }
+    }
+    ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, GGML_PAD(extra, align));
+    if (!buf) return nullptr;
+    ggml_backend_buffer_clear(buf, 0);
+    char * base = (char *) ggml_backend_buffer_get_base(buf);
+    for (auto & [t, off] : where) {
+        if (ggml_backend_tensor_alloc(buf, t, base + off) != GGML_STATUS_SUCCESS) {
+            ggml_backend_buffer_free(buf);
+            return nullptr;
+        }
+    }
+    keryx_llama_canonical_base  = base;
+    keryx_llama_canonical_bytes = total;
+    LLAMA_LOG_INFO("%s: keryx canonical weights: %zu tensors, stream %.2f MiB at %p (+%.2f MiB slack/extra)\n", __func__,
+        where.size(), total / 1048576.0, (void *) base, (extra - total) / 1048576.0);
+    return buf;
+}
