+float * ggml_cuda_q8s_lse_target(const ggml_tensor * kqv, bool stream_k) {
+    qs_dev * s = qs_current();
+    if (!s) {
+        return nullptr;
+    }
+    const int il = qs_layer_of(kqv->src[1], "cache_k_l");
+    if (il < 0 || il >= (int) s->layer.size() || (s->layer[il].kind != Q8S_ATTN && s->layer[il].kind != Q8S_MLA)) {
+        return nullptr;
+    }
+    const uint32_t n_head = (uint32_t) kqv->ne[1], n_tokens = (uint32_t) (kqv->ne[2]*kqv->ne[3]);
+    if (stream_k || s->lse_layer >= 0 || n_head % s->layer[il].heads != 0 || (size_t) n_head*n_tokens > s->lse_cap) {
+        s->overflow = true;
+        return nullptr;
+    }
+    s->lse_layer = il;
+    s->lse_heads = n_head;
+    s->lse_tokens = n_tokens;
+    return s->lse;
+}
+
+// Log masses of `n_head` query heads at every token, grouped per key/value head:
+// out[kv][t][qi] = lse[t][kv*g + qi].
+static __global__ void qs_lse_gather(const float * lse, uint32_t n_head, uint32_t n_tokens, uint32_t g, float * out) {
+    const uint64_t i = (uint64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (i >= (uint64_t) n_head*n_tokens) {
+        return;
+    }
+    const uint32_t t = i / n_head, h = i % n_head, kv = h / g, qi = h % g;
+    out[((uint64_t) kv*n_tokens + t)*g + qi] = lse[i];
+}
+
+static void qs_lse(qs_dev & s, const ggml_tensor * node, cudaStream_t stream) {
+    const int il = qs_layer_of(node->src[1], "cache_k_l");
+    if (s.lse_layer < 0 && (il < 0 || il >= (int) s.layer.size() || (s.layer[il].kind != Q8S_ATTN && s.layer[il].kind != Q8S_MLA))) {
+        return;
+    }
+    if (il != s.lse_layer) {
+        s.overflow = true;
+        s.lse_layer = -1;
+        return;
+    }
+    const qs_layer & L = s.layer[il];
+    const uint32_t g = s.lse_heads / L.heads, n = s.lse_heads*s.lse_tokens;
+    qs_lse_gather<<<(n + 255)/256, 256, 0, stream>>>(s.lse, s.lse_heads, s.lse_tokens, g, (float *) s.scratch);
+    const uint32_t len = s.lse_tokens*g*sizeof(float);
+    qs_append<<<L.heads, 128, 0, stream>>>(s.streams, 2*s.seq_heads*(s.n_attn + s.n_recur) + L.slot*s.seq_heads, 1, s.scratch, len, len, s.d_caps, s.n_caps);
+    s.lse_pos[il] += s.lse_tokens;
+    s.lse_layer = -1;
+}
