     }
+    if (lse_out) {
+        const int64_t nrows = ggml_nrows(KQV);
+        flash_attn_lse_from_meta<<<(nrows + 255)/256, 256, 0, main_stream>>>(dst_tmp_meta.ptr, parallel_blocks, nrows, lse_out);
+    }
     CUDA_CHECK(cudaGetLastError());
 }
