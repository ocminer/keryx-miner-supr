@@ -6,6 +6,28 @@
 
 #include <cstdint>
 
+// Device buffer for the log softmax mass of every row of `kqv` when its sequence leaves are
+// traced, else null.
+float * ggml_cuda_q8s_lse_target(const ggml_tensor * kqv, bool stream_k);
+
+// Log softmax mass of each row from the (max, sum) of its `parallel_blocks` parts.
+static __global__ void flash_attn_lse_from_meta(const float2 * meta, const int parallel_blocks, const int64_t nrows, float * lse) {
+    const int64_t r = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (r >= nrows) {
+        return;
+    }
+    const float2 * m = meta + r*parallel_blocks;
+    double kqmax = m[0].x;
+    for (int l = 1; l < parallel_blocks; ++l) {
+        kqmax = fmax(kqmax, (double) m[l].x);
+    }
+    double sum = 0.0;
+    for (int l = 0; l < parallel_blocks; ++l) {
+        sum += (double) m[l].y*exp((double) m[l].x - kqmax);
+    }
+    lse[r] = (float) (kqmax + log(sum));
+}
+
 #define FATTN_KQ_STRIDE       256
 #define HALF_MAX_HALF         __float2half(65504.0f/2) // Use neg. of this instead of -INFINITY to initialize KQ max vals to avoid NaN upon subtraction.
 #define SOFTMAX_FTZ_THRESHOLD -20.0f                   // Softmax exp. of values smaller than this are flushed to zero to avoid NaNs.
